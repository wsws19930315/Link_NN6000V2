# Docker Stack Dependencies for nftables Backend
# This file contains dependencies required for Docker v29.3.x with nftables default

# Core docker dependencies
CONFIG_PACKAGE_kmod-crypto-acompress=n
CONFIG_PACKAGE_kmod-crypto-blake2b=n
CONFIG_PACKAGE_kmod-crypto-xxhash=n
CONFIG_PACKAGE_kmod-fs-btrfs=n
CONFIG_PACKAGE_kmod-lib-lzo=n
CONFIG_PACKAGE_kmod-lib-raid6=n
CONFIG_PACKAGE_kmod-lib-xor=n
CONFIG_PACKAGE_kmod-lib-xxhash=n
CONFIG_PACKAGE_kmod-lib-zlib-deflate=n
CONFIG_PACKAGE_kmod-lib-zlib-inflate=n
CONFIG_PACKAGE_kmod-lib-zstd=n

# Network device modules for Docker
CONFIG_PACKAGE_kmod-dummy=n
